<?xml version="1.0" encoding="utf-8"?>
<resources>
        <style name="MeldCXButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
            <!-- Button background color -->
            <item name="android:background">@drawable/bg_button</item>
            <!-- Text color -->
            <item name="android:textColor">@color/textOnPrimary</item>
            <!-- Optional text style -->
            <item name="android:textStyle">bold</item>
            <item name="android:textAllCaps">false</item>
        </style>

    <!-- EditText style -->
    <style name="EditTextStyle" parent="">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:background">@drawable/bg_text_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">@dimen/text_size_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:colorControlActivated">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>

    <!-- DatePicker dialog style -->
    <style name="datepicker" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="android:colorAccent">@color/colorSecondary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textColorPrimaryInverse">@color/textOnPrimary</item>
        <item name="android:textColorSecondaryInverse">@color/textOnPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="android:buttonBarButtonStyle">@style/ButtonStyle</item>
    </style>

    <!-- Button style -->
    <style name="ButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

</resources>
